# Copy to .env.dev for local development. Supply runtime env/Secrets in Kubernetes.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_MODEL=gpt-4o
DATABASE_PATH=pwbot.sqlite
# Dev lifecycle tracing: request IDs, stages, timings, safe outcomes; no message/tool bodies.
# DEBUG=1
# Whole discovery/agent budget; independent per-call limits.
OPENAI_TIMEOUT_MS=600000
MODEL_CALL_TIMEOUT_MS=90000
TOOL_CALL_TIMEOUT_MS=30000
AGENT_MAX_TURNS=16
AGENT_MAX_TOOL_CALLS=48

# Optional LiteLLM tools: discover every MCP server granted to OPENAI_API_KEY.
# Derives /mcp from OPENAI_API_BASE's origin when explicitly enabled.
# LITELLM_MCP_ENABLED=true
# Or set an explicit MCP URL. Explicit false overrides all URLs.
LITELLM_MCP_URL=
# v2 archive-only SLACK_ARCHIVE_MCP_URL / SLACK_ARCHIVE_ENABLED remain supported.

# Optional read-only live Slack: all three app credentials must be present.
# Configure the same Slack app as SLACK_BOT_TOKEN. Each user authorizes separately.
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_MCP_CREDENTIALS_DIR=.slack-mcp
# SLACK_LIVE_MCP_ENABLED=false

# Local OAuth CLI callback; register the exact URL with your Slack app.
SLACK_OAUTH_REDIRECT_URI=http://localhost:43931/slack/oauth/callback

# Local manifest administration only; omit these from runtime Kubernetes Secrets.
SLACK_APP_CONFIG_TOKEN=
SLACK_APP_CONFIG_REFRESH_TOKEN=
