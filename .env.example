# Copy to .env.dev for local development. Supply runtime env/Secrets in Kubernetes.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_MODEL=gpt-4o
DATABASE_PATH=pwbot.sqlite

# Optional historical archive: enabled only when a valid HTTP(S) URL is set.
# Authenticates with the existing OPENAI_API_KEY. Explicit false overrides the URL.
SLACK_ARCHIVE_MCP_URL=
# SLACK_ARCHIVE_ENABLED=false

# Optional read-only live Slack: all three app credentials must be present.
# Configure the same Slack app as SLACK_BOT_TOKEN. Each user authorizes separately.
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_MCP_CREDENTIALS_DIR=.slack-mcp
# SLACK_LIVE_MCP_ENABLED=false

# Local OAuth CLI callback; register the exact URL with your Slack app.
SLACK_OAUTH_REDIRECT_URI=http://localhost:43931/slack/oauth/callback

# Local manifest administration only; omit these from runtime Kubernetes Secrets.
SLACK_APP_CONFIG_TOKEN=
SLACK_APP_CONFIG_REFRESH_TOKEN=
